import BigHrushovski.C0AncestorClosure

/-!
# Closure generated by finite sets in the unary C0 presentation

The previous module defines C(v), the finite union of
closure-components reached by decreasing back edges. This
module gives the ordinary finite-set closure induced by the
unary operation v ↦ C(v):

    cl_F(s) = ⋃ (v ∈ s), C(v).

It verifies extensivity, monotonicity, idempotence, finite
unions and the leastness property among finite unary-closed
sets. These are the exact closure identities used at the
start of the manuscript's functional-closure lemma.

This remains distinct from intrinsic strong graph closure,
and no free-amalgamation/Fraisse property is asserted here.
-/

namespace BigHrushovski
namespace FiniteCatalogue

/-- Finite subsets closed under the entire unary function value,
not merely unions of enumeration blocks. -/
def IsGenericC0UnaryClosed (s : Finset ℕ) : Prop :=
  ∀ v ∈ s, genericC0UnaryClosure v ⊆ s

/-- The substructure generated by a finite set in the unary language. -/
noncomputable def genericC0GeneratedClosure (s : Finset ℕ) : Finset ℕ :=
  s.biUnion genericC0UnaryClosure

theorem mem_genericC0GeneratedClosure_iff (s : Finset ℕ) (w : ℕ) :
    w ∈ genericC0GeneratedClosure s ↔
      ∃ v ∈ s, w ∈ genericC0UnaryClosure v := by
  simp only [genericC0GeneratedClosure, Finset.mem_biUnion]

theorem genericC0GeneratedClosure_extensive (s : Finset ℕ) :
    s ⊆ genericC0GeneratedClosure s := by
  intro x hx
  exact (mem_genericC0GeneratedClosure_iff s x).mpr
    ⟨x, hx, genericC0UnaryClosure_self x⟩

theorem genericC0GeneratedClosure_isClosed (s : Finset ℕ) :
    IsGenericC0UnaryClosed (genericC0GeneratedClosure s) := by
  intro v hv w hw
  obtain ⟨x, hx, hvx⟩ :=
    (mem_genericC0GeneratedClosure_iff s v).mp hv
  exact (mem_genericC0GeneratedClosure_iff s w).mpr
    ⟨x, hx, genericC0UnaryClosure_trans hvx hw⟩

theorem genericC0GeneratedClosure_least
    (s t : Finset ℕ) (hst : s ⊆ t)
    (ht : IsGenericC0UnaryClosed t) :
    genericC0GeneratedClosure s ⊆ t := by
  intro w hw
  obtain ⟨v, hv, hwv⟩ :=
    (mem_genericC0GeneratedClosure_iff s w).mp hw
  exact (ht v (hst hv)) hwv

theorem genericC0GeneratedClosure_mono {s t : Finset ℕ}
    (hst : s ⊆ t) :
    genericC0GeneratedClosure s ⊆ genericC0GeneratedClosure t := by
  intro w hw
  obtain ⟨v, hv, hwv⟩ :=
    (mem_genericC0GeneratedClosure_iff s w).mp hw
  exact (mem_genericC0GeneratedClosure_iff t w).mpr
    ⟨v, hst hv, hwv⟩

theorem genericC0GeneratedClosure_idempotent (s : Finset ℕ) :
    genericC0GeneratedClosure (genericC0GeneratedClosure s) =
      genericC0GeneratedClosure s := by
  apply le_antisymm
  · exact genericC0GeneratedClosure_least
      (genericC0GeneratedClosure s) (genericC0GeneratedClosure s)
      (Finset.Subset.rfl) (genericC0GeneratedClosure_isClosed s)
  · exact genericC0GeneratedClosure_extensive (genericC0GeneratedClosure s)

theorem genericC0UnaryClosed_iff_generated_eq_self (s : Finset ℕ) :
    IsGenericC0UnaryClosed s ↔ genericC0GeneratedClosure s = s := by
  constructor
  · intro hs
    exact le_antisymm
      (genericC0GeneratedClosure_least s s (Finset.Subset.rfl) hs)
      (genericC0GeneratedClosure_extensive s)
  · intro hs
    have hc := genericC0GeneratedClosure_isClosed s
    rw [hs] at hc
    exact hc

theorem genericC0UnaryClosed_inter {s t : Finset ℕ}
    (hs : IsGenericC0UnaryClosed s)
    (ht : IsGenericC0UnaryClosed t) :
    IsGenericC0UnaryClosed (s ∩ t) := by
  intro v hv w hw
  have hvs : v ∈ s := (Finset.mem_inter.mp hv).1
  have hvt : v ∈ t := (Finset.mem_inter.mp hv).2
  exact Finset.mem_inter.mpr
    ⟨(hs v hvs) hw, (ht v hvt) hw⟩

theorem genericC0UnaryClosed_union {s t : Finset ℕ}
    (hs : IsGenericC0UnaryClosed s)
    (ht : IsGenericC0UnaryClosed t) :
    IsGenericC0UnaryClosed (s ∪ t) := by
  intro v hv w hw
  rcases Finset.mem_union.mp hv with hvs | hvt
  · exact Finset.mem_union.mpr (Or.inl ((hs v hvs) hw))
  · exact Finset.mem_union.mpr (Or.inr ((ht v hvt) hw))

theorem genericC0GeneratedClosure_union (s t : Finset ℕ) :
    genericC0GeneratedClosure (s ∪ t) =
      genericC0GeneratedClosure s ∪ genericC0GeneratedClosure t := by
  ext w
  constructor
  · intro hw
    obtain ⟨v, hv, hwv⟩ :=
      (mem_genericC0GeneratedClosure_iff (s ∪ t) w).mp hw
    rcases Finset.mem_union.mp hv with hvs | hvt
    · exact Finset.mem_union.mpr (Or.inl
        ((mem_genericC0GeneratedClosure_iff s w).mpr
          ⟨v, hvs, hwv⟩))
    · exact Finset.mem_union.mpr (Or.inr
        ((mem_genericC0GeneratedClosure_iff t w).mpr
          ⟨v, hvt, hwv⟩))
  · intro hw
    rcases Finset.mem_union.mp hw with hws | hwt
    · obtain ⟨v, hv, hwv⟩ :=
        (mem_genericC0GeneratedClosure_iff s w).mp hws
      exact (mem_genericC0GeneratedClosure_iff (s ∪ t) w).mpr
        ⟨v, Finset.mem_union.mpr (Or.inl hv), hwv⟩
    · obtain ⟨v, hv, hwv⟩ :=
        (mem_genericC0GeneratedClosure_iff t w).mp hwt
      exact (mem_genericC0GeneratedClosure_iff (s ∪ t) w).mpr
        ⟨v, Finset.mem_union.mpr (Or.inr hv), hwv⟩

theorem genericC0GeneratedClosure_singleton (v : ℕ) :
    genericC0GeneratedClosure ({v} : Finset ℕ) =
      genericC0UnaryClosure v := by
  ext w
  constructor
  · intro hw
    obtain ⟨x, hx, hwx⟩ :=
      (mem_genericC0GeneratedClosure_iff {v} w).mp hw
    have heq : x = v := Finset.mem_singleton.mp hx
    simpa only [heq] using hwx
  · intro hw
    exact (mem_genericC0GeneratedClosure_iff {v} w).mpr
      ⟨v, Finset.mem_singleton_self v, hw⟩

end FiniteCatalogue
end BigHrushovski
