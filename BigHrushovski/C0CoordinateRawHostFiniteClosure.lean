import BigHrushovski.C0CoordinateRawHostGraph
import BigHrushovski.C0CoordinateHostGraph

/-!
# Finite unary-closed subsets of the preliminary C₀ coordinate host

The finite unary operation on the raw code host is reflexive and
nested. Hence the union of the complete one-generated closures of a
finite set is itself finite, closed under the complete unary values,
and is the least closed set containing the original vertices.

We also reuse the general graph lemma saying that two unary-closed
sets have no graph edges between their exclusive parts, provided
every edge is covered by the complete unary closure of an endpoint.

These facts belong to the preliminary raw host. The finite-age
converse, the coherent selected local orders, and the countable
return map for the manuscript's W remain separate obligations.
-/

namespace BigHrushovski
namespace FiniteUnaryCoordinates

/-- A finite set of raw code vertices is closed under the COMPLETE
named unary value C, not just under graph adjacency. -/
def RawC0CoordinateVertex.IsClosed
    (s : Finset RawC0CoordinateVertex) : Prop :=
  ∀ q ∈ s, q.closedValue ⊆ s

/-- Every complete one-generated raw unary value is closed. -/
theorem RawC0CoordinateVertex.closedValue_isClosed
    (q : RawC0CoordinateVertex) :
    RawC0CoordinateVertex.IsClosed q.closedValue := by
  intro r hr
  exact q.closedValue_nested r hr

/-- The finite union of all complete C-values generated by
a given finite family of raw host vertices. -/
noncomputable def RawC0CoordinateVertex.closeFinite
    (s : Finset RawC0CoordinateVertex) :
    Finset RawC0CoordinateVertex := by
  classical
  exact s.biUnion (fun q => q.closedValue)

/-- Every member of the finite generated closure comes from one
member of the original finite set and its full C-value. -/
theorem RawC0CoordinateVertex.mem_closeFinite_iff
    (s : Finset RawC0CoordinateVertex)
    (q : RawC0CoordinateVertex) :
    q ∈ RawC0CoordinateVertex.closeFinite s ↔
      ∃ r ∈ s, q ∈ r.closedValue := by
  classical
  simp [RawC0CoordinateVertex.closeFinite]

/-- Reflexivity ensures the original finite set is contained in
its complete generated closure. -/
theorem RawC0CoordinateVertex.subset_closeFinite
    (s : Finset RawC0CoordinateVertex) :
    s ⊆ RawC0CoordinateVertex.closeFinite s := by
  intro q hq
  exact (RawC0CoordinateVertex.mem_closeFinite_iff s q).mpr
    ⟨q,hq,q.mem_closedValue_self⟩

/-- Nestedness ensures that the complete closure of a finite
family is already closed under all complete unary values. -/
theorem RawC0CoordinateVertex.closeFinite_isClosed
    (s : Finset RawC0CoordinateVertex) :
    RawC0CoordinateVertex.IsClosed
      (RawC0CoordinateVertex.closeFinite s) := by
  intro q hq r hr
  obtain ⟨u,hu,hqu⟩ :=
    (RawC0CoordinateVertex.mem_closeFinite_iff s q).mp hq
  exact (RawC0CoordinateVertex.mem_closeFinite_iff s r).mpr
    ⟨u,hu,u.closedValue_nested q hqu hr⟩

/-- Leastness of complete generated closure among closed finite
supersets; no extra closure iteration is needed. -/
theorem RawC0CoordinateVertex.closeFinite_le_closed
    (s t : Finset RawC0CoordinateVertex)
    (hst : s ⊆ t)
    (ht : RawC0CoordinateVertex.IsClosed t) :
    RawC0CoordinateVertex.closeFinite s ⊆ t := by
  intro q hq
  obtain ⟨r,hr,hqr⟩ :=
    (RawC0CoordinateVertex.mem_closeFinite_iff s q).mp hq
  exact ht r (hst hr) hqr

/-- Closing a finite set twice makes no further change. -/
theorem RawC0CoordinateVertex.closeFinite_idempotent
    (s : Finset RawC0CoordinateVertex) :
    RawC0CoordinateVertex.closeFinite
      (RawC0CoordinateVertex.closeFinite s) =
        RawC0CoordinateVertex.closeFinite s := by
  apply Finset.Subset.antisymm
  · exact RawC0CoordinateVertex.closeFinite_le_closed
      (RawC0CoordinateVertex.closeFinite s)
      (RawC0CoordinateVertex.closeFinite s)
      Finset.Subset.rfl
      (RawC0CoordinateVertex.closeFinite_isClosed s)
  · exact RawC0CoordinateVertex.subset_closeFinite
      (RawC0CoordinateVertex.closeFinite s)

/-- The intersection of two complete unary-closed finite sets
is closed under every complete unary value. -/
theorem RawC0CoordinateVertex.isClosed_inter
    (s t : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s)
    (ht : RawC0CoordinateVertex.IsClosed t) :
    RawC0CoordinateVertex.IsClosed (s ∩ t) := by
  intro q hq r hr
  obtain ⟨hqs,hqt⟩ := Finset.mem_inter.mp hq
  exact Finset.mem_inter.mpr
    ⟨hs q hqs hr, ht q hqt hr⟩

/-- The union of two complete unary-closed finite sets is likewise
closed under every complete unary value. -/
theorem RawC0CoordinateVertex.isClosed_union
    (s t : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s)
    (ht : RawC0CoordinateVertex.IsClosed t) :
    RawC0CoordinateVertex.IsClosed (s ∪ t) := by
  intro q hq r hr
  rcases Finset.mem_union.mp hq with hqs | hqt
  · exact Finset.mem_union.mpr (Or.inl (hs q hqs hr))
  · exact Finset.mem_union.mpr (Or.inr (ht q hqt hr))

/-- Two finite complete-C-closed sets have no graph edges between
their exclusive parts. This is an INSTANCE of the already-proved
general graph lemma, not another graph-specific closure argument. -/
theorem rawC0HostGraph_noCross_between
    (s t : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s)
    (ht : RawC0CoordinateVertex.IsClosed t)
    {q r : RawC0CoordinateVertex}
    (hqs : q ∈ s) (hqt : q ∉ t)
    (hrt : r ∈ t) (hrs : r ∉ s) :
    ¬ rawC0HostGraph.adj q r := by
  classical
  exact rawC0HostGraph.noCrossEdges_of_closed
    RawC0CoordinateVertex.closedValue
    rawC0HostGraph_edge_covered s t hs ht
    hqs hqt hrt hrs

end FiniteUnaryCoordinates
end BigHrushovski
