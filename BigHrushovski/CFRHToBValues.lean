import BigHrushovski.CFSupportInsideGenerated
import BigHrushovski.CFRHClosedSubstructures
import BigHrushovski.CFDClosedTransport

/-!
# Complete b-value recovery from R,H and the birth-level preorder

For a literal C_F birth vertex v, write C(v) for its finite
generated b-closure, B(v) for its complete tagged birth block,
and P(v) for its named old support.

The previously validated lemmas establish:
* B(v) is exactly the vertices of C(v) on the level of v;
* P(v) is the finite d-hull inside C(v) of all neighbours of
  B(v) in C(v)\B(v).

Consequently an induced injection f which preserves exact C-values
and reflects equality of birth levels preserves the complete B-
and P-values, and therefore all auxiliary b-values. This is the
converse value-transport needed for the (R,H)-to-b implication.

The final theorem obtains exact C-value transport from the
preservation of complete R(v) and H(S) values on finite root sets.
No root-set quotient or category-theoretic formalism is introduced.

The global-map theorem still has explicit level and value hypotheses.
To cover embeddings of arbitrary finite source substructures,
these facts must be applied to the induced map on the finite
C(v)-interval and combined with the order/partial-domain interface.
-/

namespace BigHrushovski
namespace CFCoherentTower

/-- The finite auxiliary b-closure generated by the vertex v. -/
noncomputable def birthCValue
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (v : Vertex F K) : Finset (Vertex F K) :=
  birthGeneratedClosure F K ({v} : Finset (Vertex F K))

/-- The entire literal birth block containing v. -/
noncomputable def birthBlockOf
    (F : ℕ → ℝ) (K : ℕ → ℕ) :
    Vertex F K → Finset (Vertex F K)
  | ⟨n, ⟨r, _⟩⟩ => birthBlock F K n r

/-- The complete old named support of the literal birth block
containing v. It need not equal its graph-neighbour set. -/
noncomputable def birthSupportOf
    (F : ℕ → ℝ) (K : ℕ → ℕ) :
    Vertex F K → Finset (Vertex F K)
  | ⟨n, ⟨r, _⟩⟩ => birthSupport F K n r

theorem birthBValue_eq_support_union_block
    (F : ℕ → ℝ) (K : ℕ → ℕ) (v : Vertex F K) :
    birthBValue F K v =
      birthSupportOf F K v ∪ birthBlockOf F K v := by
  rcases v with ⟨n, ⟨r, i⟩⟩
  rfl

/-- The top birth-level formula, with the block distinguished
by C(v) and equality of birth levels only. -/
theorem birthBlockOf_mem_iff
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (v w : Vertex F K) :
    w ∈ birthBlockOf F K v ↔
      w ∈ birthCValue F K v ∧ w.1 = v.1 := by
  rcases v with ⟨n, ⟨r, i⟩⟩
  exact (birthGeneratedClosure_topBlock_iff F K n r i w).symm

/-- The intrinsic finite support formula, expressed using only
the C(v)-interval and its top birth block. -/
theorem birthSupportOf_eq_hull_inside
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (v : Vertex F K) :
    (countableGraph F K).toPredimension.dClosedHull
      ((countableGraph F K).oldNeighbourSet
        (birthCValue F K v \ birthBlockOf F K v)
        (birthBlockOf F K v))
      (birthCValue F K v) =
        birthSupportOf F K v := by
  rcases v with ⟨n, ⟨r, i⟩⟩
  exact birthSupport_eq_hull_inside_generated F K n r i

/-- For an injective map, image commutes with finite set
difference. This is elementary but avoids an implicit
surjectivity assumption in the support-image argument. -/
theorem finite_image_sdiff_of_injective
    {V W : Type*} [DecidableEq V] [DecidableEq W]
    (f : V → W) (hf : Function.Injective f)
    (a b : Finset V) :
    (a \ b).image f = a.image f \ b.image f := by
  classical
  ext y
  constructor
  · intro hy
    obtain ⟨x, hx, hxy⟩ := Finset.mem_image.mp hy
    obtain ⟨hxa, hxb⟩ := Finset.mem_sdiff.mp hx
    apply Finset.mem_sdiff.mpr
    constructor
    · exact Finset.mem_image.mpr ⟨x, hxa, hxy⟩
    · intro hyB
      obtain ⟨u, huB, huy⟩ := Finset.mem_image.mp hyB
      have hux : u = x := hf (huy.trans hxy.symm)
      exact hxb (hux ▸ huB)
  · intro hy
    obtain ⟨hyA, hyNotB⟩ := Finset.mem_sdiff.mp hy
    obtain ⟨x, hxa, hxy⟩ := Finset.mem_image.mp hyA
    have hxb : x ∉ b := by
      intro hxB
      exact hyNotB (Finset.mem_image.mpr ⟨x, hxB, hxy⟩)
    exact Finset.mem_image.mpr
      ⟨x, Finset.mem_sdiff.mpr ⟨hxa, hxb⟩, hxy⟩

/-- Exact C-value images plus the reflected birth-level equality
already determine exact images of the complete birth blocks.
No order on the dependent request codes is used in this lemma. -/
theorem birthBlockOf_image_of_closure_levels
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (f : Vertex F K → Vertex F K)
    (hC : ∀ v : Vertex F K,
      (birthCValue F K v).image f = birthCValue F K (f v))
    (hLevel : ∀ u v : Vertex F K,
      u.1 = v.1 ↔ (f u).1 = (f v).1)
    (v : Vertex F K) :
    (birthBlockOf F K v).image f = birthBlockOf F K (f v) := by
  classical
  ext y
  constructor
  · intro hy
    obtain ⟨x, hxB, hxy⟩ := Finset.mem_image.mp hy
    obtain ⟨hxC, hxLevel⟩ :=
      (birthBlockOf_mem_iff F K v x).mp hxB
    have hfC : f x ∈ birthCValue F K (f v) := by
      rw [← hC v]
      exact Finset.mem_image.mpr ⟨x, hxC, rfl⟩
    have hfLevel : (f x).1 = (f v).1 :=
      (hLevel x v).mp hxLevel
    have hyC : y ∈ birthCValue F K (f v) := by
      rw [← hxy]
      exact hfC
    have hyLevel : y.1 = (f v).1 := by
      rw [← hxy]
      exact hfLevel
    exact (birthBlockOf_mem_iff F K (f v) y).mpr
      ⟨hyC, hyLevel⟩
  · intro hy
    obtain ⟨hyC, hyLevel⟩ :=
      (birthBlockOf_mem_iff F K (f v) y).mp hy
    have hImage : y ∈ (birthCValue F K v).image f := by
      rw [hC v]
      exact hyC
    obtain ⟨x, hxC, hxy⟩ := Finset.mem_image.mp hImage
    have hxLevel : x.1 = v.1 :=
      (hLevel x v).mpr (by rw [hxy]; exact hyLevel)
    have hxB : x ∈ birthBlockOf F K v :=
      (birthBlockOf_mem_iff F K v x).mpr ⟨hxC, hxLevel⟩
    exact Finset.mem_image.mpr ⟨x, hxB, hxy⟩

/-- Once complete C(v) and B(v) values are transported by an
induced injection, the intrinsic finite support formula
transports the entire old named support. -/
theorem birthSupportOf_image_of_closure_levels
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (f : Vertex F K → Vertex F K)
    (hf : Function.Injective f)
    (hAdj : ∀ u v : Vertex F K,
      (countableGraph F K).adj u v ↔
        (countableGraph F K).adj (f u) (f v))
    (hC : ∀ v : Vertex F K,
      (birthCValue F K v).image f = birthCValue F K (f v))
    (hLevel : ∀ u v : Vertex F K,
      u.1 = v.1 ↔ (f u).1 = (f v).1)
    (v : Vertex F K) :
    (birthSupportOf F K v).image f = birthSupportOf F K (f v) := by
  classical
  let G := countableGraph F K
  let d := G.toPredimension
  let C := birthCValue F K v
  let C' := birthCValue F K (f v)
  let B := birthBlockOf F K v
  let B' := birthBlockOf F K (f v)
  let N := G.oldNeighbourSet (C \ B) B
  let N' := G.oldNeighbourSet (C' \ B') B'
  have hCImage : C.image f = C' := hC v
  have hBImage : B.image f = B' :=
    birthBlockOf_image_of_closure_levels F K f hC hLevel v
  have hDiff : (C \ B).image f = C' \ B' := by
    calc
      (C \ B).image f = C.image f \ B.image f :=
        finite_image_sdiff_of_injective f hf C B
      _ = C' \ B' := by rw [hCImage, hBImage]
  have hNImage : N.image f = N' := by
    change (G.oldNeighbourSet (C \ B) B).image f =
      G.oldNeighbourSet (C' \ B') B'
    calc
      (G.oldNeighbourSet (C \ B) B).image f =
          G.oldNeighbourSet ((C \ B).image f) (B.image f) :=
        G.oldNeighbourSet_image G f hAdj (C \ B) B
      _ = G.oldNeighbourSet (C' \ B') B' := by
        rw [hDiff, hBImage]
  have hNsubsetC : N ⊆ C :=
    (G.oldNeighbourSet_subset (C \ B) B).trans Finset.sdiff_subset
  have hSrc : d.dClosedHull N C = birthSupportOf F K v :=
    birthSupportOf_eq_hull_inside F K v
  have hDst : d.dClosedHull N' C' = birthSupportOf F K (f v) :=
    birthSupportOf_eq_hull_inside F K (f v)
  calc
    (birthSupportOf F K v).image f =
        (d.dClosedHull N C).image f :=
      congrArg (Finset.image f) hSrc.symm
    _ = d.dClosedHull (N.image f) (C.image f) :=
      G.dClosedHull_image G f hf hAdj N C hNsubsetC
    _ = d.dClosedHull N' C' := by rw [hNImage, hCImage]
    _ = birthSupportOf F K (f v) := hDst

/-- The complete auxiliary b-value is an intrinsic finite graph
function of C(v), the birth-level partition, and the edges.
The image equality is exact, not merely an inclusion. -/
theorem birthBValue_image_of_closure_levels
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (f : Vertex F K → Vertex F K)
    (hf : Function.Injective f)
    (hAdj : ∀ u v : Vertex F K,
      (countableGraph F K).adj u v ↔
        (countableGraph F K).adj (f u) (f v))
    (hC : ∀ v : Vertex F K,
      (birthCValue F K v).image f = birthCValue F K (f v))
    (hLevel : ∀ u v : Vertex F K,
      u.1 = v.1 ↔ (f u).1 = (f v).1)
    (v : Vertex F K) :
    (birthBValue F K v).image f = birthBValue F K (f v) := by
  rw [birthBValue_eq_support_union_block F K v,
    birthBValue_eq_support_union_block F K (f v),
    Finset.image_union,
    birthSupportOf_image_of_closure_levels F K f hf hAdj hC hLevel v,
    birthBlockOf_image_of_closure_levels F K f hC hLevel v]

/-- Exact H and R values of an (R,H)-embedding force the full
generated b-closure of each vertex to have the exact image. -/
theorem birthCValue_image_of_RHValues
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (f : Vertex F K → Vertex F K)
    (hR : ∀ v : Vertex F K,
      (birthReachableRoots F K v).image f =
        birthReachableRoots F K (f v))
    (hH : ∀ s : Finset (Vertex F K),
      (∀ r ∈ s, IsBirthRoot F K r) →
      (birthDClosedHull F K s).image f =
        birthDClosedHull F K (s.image f))
    (v : Vertex F K) :
    (birthCValue F K v).image f = birthCValue F K (f v) := by
  have hRoots : ∀ r ∈ birthReachableRoots F K v,
      IsBirthRoot F K r :=
    reachableRoots_are_roots F K v
  calc
    (birthCValue F K v).image f =
        (birthDClosedHull F K (birthReachableRoots F K v)).image f :=
      congrArg (Finset.image f) (birthRoot_recovery F K v).symm
    _ = birthDClosedHull F K ((birthReachableRoots F K v).image f) :=
      hH (birthReachableRoots F K v) hRoots
    _ = birthDClosedHull F K (birthReachableRoots F K (f v)) := by
      rw [hR v]
    _ = birthCValue F K (f v) := birthRoot_recovery F K (f v)

/-- The RH-to-b value implication under the exact hypotheses
supplied by an induced order/level preserving embedding.
The full source-substructure version is a separate interface. -/
theorem birthBValue_image_of_RHValues
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (f : Vertex F K → Vertex F K)
    (hf : Function.Injective f)
    (hAdj : ∀ u v : Vertex F K,
      (countableGraph F K).adj u v ↔
        (countableGraph F K).adj (f u) (f v))
    (hLevel : ∀ u v : Vertex F K,
      u.1 = v.1 ↔ (f u).1 = (f v).1)
    (hR : ∀ v : Vertex F K,
      (birthReachableRoots F K v).image f =
        birthReachableRoots F K (f v))
    (hH : ∀ s : Finset (Vertex F K),
      (∀ r ∈ s, IsBirthRoot F K r) →
      (birthDClosedHull F K s).image f =
        birthDClosedHull F K (s.image f))
    (v : Vertex F K) :
    (birthBValue F K v).image f = birthBValue F K (f v) :=
  birthBValue_image_of_closure_levels F K f hf hAdj
    (birthCValue_image_of_RHValues F K f hR hH)
    hLevel v

end CFCoherentTower
end BigHrushovski
