import BigHrushovski.C0ComponentValues
import BigHrushovski.C0UnaryClosedStrong

/-!
# Each finite C0 enumeration prefix is closed under the unary function

The minimal enumeration is indexed by natural numbers. Dependencies
from a closure-component point only to *earlier* components.
Consequently the full unary closure of any vertex already in A_n
lies in A_n. No later component can become part of a previously
assigned unary value.

This is the exact persistence invariant needed when interleaving
future functional extension requests with exhaustive minimal runs.
It does not itself construct the fair request scheduler.
-/

namespace BigHrushovski
namespace FiniteCatalogue

/-- Every element of C(v) appears no later than v in the component
enumeration, so C(v) belongs to any initial stage already containing v. -/
theorem genericC0UnaryClosure_subset_stage
    (v n : ℕ) (hv : v ∈ genericC0MinimalStage n) :
    genericC0UnaryClosure v ⊆ genericC0MinimalStage n := by
  intro w hw
  have hiV : genericC0ComponentIndex v < n :=
    (genericC0ComponentIndex_lt_iff_stage v n).mpr hv
  have hiW : genericC0ComponentIndex w ≤ genericC0ComponentIndex v :=
    ((mem_genericC0UnaryClosure_iff v w).mp hw).le
  exact (genericC0ComponentIndex_lt_iff_stage w n).mp
    (lt_of_le_of_lt hiW hiV)

/-- Each finite strong stage is also literally closed under f_Cl,
not merely strong in the underlying graph. -/
theorem genericC0MinimalStage_unaryClosed (n : ℕ) :
    IsGenericC0UnaryClosed (genericC0MinimalStage n) := by
  intro v hv w hw
  exact genericC0UnaryClosure_subset_stage v n hv hw

/-- The whole unary substructure generated by a finite stage is the
same stage: future blocks cannot add an ancestor to an old vertex. -/
theorem genericC0MinimalStage_generated_eq (n : ℕ) :
    genericC0GeneratedClosure (genericC0MinimalStage n) =
      genericC0MinimalStage n :=
  (genericC0UnaryClosed_iff_generated_eq_self
    (genericC0MinimalStage n)).mp
    (genericC0MinimalStage_unaryClosed n)

end FiniteCatalogue
end BigHrushovski
