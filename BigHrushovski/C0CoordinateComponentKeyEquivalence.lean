import BigHrushovski.C0CoordinateMutualCodeKeyJ

/-!
# Complete unpointed keys classify raw C₀ closure-components

The preceding module showed that if raw host codes q and r
generate each other, then their complete unpointed coordinate keys
agree. Here we prove the converse.

The complete unpointed key retains the literal finite support,
all graph pairs and all unary C-incidences. Equality of these
data, together with the fact that each code is generated by its
point, makes either code the exact generated child of the other.
Thus equality of keys is equivalent to mutual C-membership, and
also to equality of complete one-generated C-values.

This identifies closure-components in the preliminary RAW code
host; it is not the coherent ordered local-type selection or the
countable return map of the manuscript.
-/

namespace BigHrushovski
namespace FiniteUnaryCoordinates

/-- Complete unpointed key equality makes r the EXACT generated
child at its own coordinate in the full code q. No coordinate
support or C-matrix is compared in isolation. -/
theorem RawC0CoordinateVertex.mem_closedValue_of_unpointedKey_eq
    (q r : RawC0CoordinateVertex)
    (h : q.val.unpointedKey = r.val.unpointedKey) :
    r ∈ q.closedValue := by
  classical
  obtain ⟨hS,hAdj,hC⟩ :=
    (q.val.unpointedKey_eq_iff r.val).mp h
  have hx : r.val.point ∈ q.val.support := by
    rw [hS]
    exact r.val.point_mem
  have hN : q.val.namedValue r.val.point = q.val.support := by
    ext y
    constructor
    · intro hy
      exact ((q.val.mem_namedValue_iff r.val.point y).mp hy).1
    · intro hy
      have hyR : y ∈ r.val.support := by
        rw [← hS]
        exact hy
      have hPairR : (r.val.point,y) ∈ r.val.closurePairs :=
        (r.val.rawC0Generated_root r.property y).mp hyR
      have hPairQ : (r.val.point,y) ∈ q.val.closurePairs := by
        rw [hC]
        exact hPairR
      exact (q.val.mem_namedValue_iff r.val.point y).mpr
        ⟨hy,hPairQ⟩
  obtain ⟨hxx,hChild⟩ :=
    q.child_complete_record r.val.point hx
  have hCon := q.val.restrictTo_support_congr
    (q.val.namedValue r.val.point)
    q.val.support hN
    (q.val.namedValue_subset_support r.val.point)
    Finset.Subset.rfl r.val.point hxx hx
  have hFull :
      q.val.restrictTo q.val.support Finset.Subset.rfl
        r.val.point hx = (q.child r.val.point hx).val :=
    hCon.symm.trans hChild
  have hKeyChild :
      (q.child r.val.point hx).val.unpointedKey =
        q.val.unpointedKey := by
    calc
      (q.child r.val.point hx).val.unpointedKey =
        (q.val.restrictTo q.val.support Finset.Subset.rfl
          r.val.point hx).unpointedKey :=
            (congrArg LiteralPointedCode.unpointedKey hFull).symm
      _ = q.val.unpointedKey :=
        q.val.restrictTo_full_unpointedKey
          (q.val.rawC0Generated_wellSupported q.property)
          r.val.point hx
  have hChildKey :
      (q.child r.val.point hx).val.unpointedKey =
        r.val.unpointedKey := hKeyChild.trans h
  obtain ⟨hSupport,hMatrix,hClosure⟩ :=
    (((q.child r.val.point hx).val).unpointedKey_eq_iff
      r.val).mp hChildKey
  have hChildEq : q.child r.val.point hx = r := by
    apply Subtype.ext
    apply LiteralPointedCode.ext
    · exact hSupport
    · exact q.child_point r.val.point hx
    · exact hMatrix
    · exact hClosure
  rw [← hChildEq]
  exact q.child_mem_closedValue r.val.point hx

/-- Mutual membership in the complete unary values is equivalent
to literal equality of complete unpointed coordinate codes.
No raw-name tie breaking and no preferred top generator are used. -/
theorem RawC0CoordinateVertex.mutual_closedValue_iff_unpointedKey
    (q r : RawC0CoordinateVertex) :
    (r ∈ q.closedValue ∧ q ∈ r.closedValue) ↔
      q.val.unpointedKey = r.val.unpointedKey := by
  constructor
  · rintro ⟨hqr,hrq⟩
    exact q.mutual_closedValue_unpointedKey r hqr hrq
  · intro h
    exact ⟨q.mem_closedValue_of_unpointedKey_eq r h,
      r.mem_closedValue_of_unpointedKey_eq q h.symm⟩

/-- Two raw vertices have the SAME complete one-generated
C-value exactly when their entire unpointed coordinate records
are equal. Thus those keys classify the raw closure-components. -/
theorem RawC0CoordinateVertex.closedValue_eq_iff_unpointedKey
    (q r : RawC0CoordinateVertex) :
    q.closedValue = r.closedValue ↔
      q.val.unpointedKey = r.val.unpointedKey := by
  constructor
  · intro h
    apply (q.mutual_closedValue_iff_unpointedKey r).mp
    constructor
    · rw [h]
      exact r.mem_closedValue_self
    · rw [← h]
      exact q.mem_closedValue_self
  · intro h
    obtain ⟨hqr,hrq⟩ :=
      (q.mutual_closedValue_iff_unpointedKey r).mpr h
    apply Finset.Subset.antisymm
    · exact r.closedValue_nested q hrq
    · exact q.closedValue_nested r hqr

end FiniteUnaryCoordinates
end BigHrushovski
