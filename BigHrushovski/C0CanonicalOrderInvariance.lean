import BigHrushovski.C0CommonBaseComponents

/-!
# Invariance of complete unary values under component reordering

A C0 component presentation is an index κ assigning a chronological
component to each vertex. The actual complete unary function
canonicalValue G κ x is the union of all components reachable from
the component of x by edges pointing to earlier components.

This file proves that canonicalValue is independent of the chosen
linear ordering of the components, provided
(i) the two indices partition vertices into the same components, and
(ii) every graph edge between components has the same orientation.

Unlike raw index equality, these two facts are invariant under
renumbering components or changing the order of incomparable ones.
This is the finite reconciliation lemma needed to combine two
independently witnessed C0 functional extensions over a common base.

No assumption about strong amalgamation or the existence of a joint
component order is hidden in the statement. That construction remains
a separate step in the complete two-sided finite amalgamation theorem.
-/
namespace BigHrushovski
namespace FiniteC0

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Intrinsic one-step predecessor on vertices. A step may move
within the same whole component or follow a graph edge to an
earlier component. -/
def BackOrSame {n : ℕ} (G : GraphOn V)
    (κ : V → Fin n) (u v : V) : Prop :=
  κ u = κ v ∨ (G.adj u v ∧ (κ v).val < (κ u).val)

/-- Vertex-level reachability generated by the complete-component
and backward-edge moves. -/
inductive VertexReach (step : V → V → Prop) (root : V) : V → Prop where
  | root : VertexReach step root root
  | next {u v : V} :
      VertexReach step root u → step u v → VertexReach step root v

private theorem reach_dependency_components {n : ℕ}
    (G : GraphOn V) (κ : V → Fin n)
    (x : V) {i : Fin n}
    (h : TaggedAmalgam.DependencyAncestor
      (backDependency G κ) (κ x) i) :
    ∃ v : V, κ v = i ∧
      VertexReach (BackOrSame G κ) x v := by
  induction h with
  | root =>
      exact ⟨x, rfl, VertexReach.root⟩
  | @step i j hAnc hDep ih =>
      obtain ⟨w, hw, hwReach⟩ := ih
      obtain ⟨hLess, u, v, hu, hv, hAdj⟩ := hDep
      have hSame : BackOrSame G κ w u :=
        Or.inl (hw.trans hu.symm)
      have hBack : BackOrSame G κ u v := by
        right
        exact ⟨hAdj, by simpa [hu, hv] using hLess⟩
      exact ⟨v, hv, VertexReach.next
        (VertexReach.next hwReach hSame) hBack⟩

/-- Complete unary value membership is exactly vertex reachability
by same-component or backwards-edge steps. -/
theorem mem_canonicalValue_iff_vertexReach {n : ℕ}
    (G : GraphOn V) (κ : V → Fin n)
    (x y : V) :
    y ∈ canonicalValue G κ x ↔
      VertexReach (BackOrSame G κ) x y := by
  constructor
  · intro hy
    obtain ⟨v, hv, hReach⟩ :=
      reach_dependency_components G κ x
        ((mem_canonicalValue_iff G κ x y).mp hy)
    exact VertexReach.next hReach (Or.inl hv)
  · intro h
    apply (mem_canonicalValue_iff G κ x y).mpr
    induction h with
    | root =>
        exact TaggedAmalgam.DependencyAncestor.root
    | @next u v hu hStep ih =>
        rcases hStep with hSame | ⟨hEdge, hLt⟩
        · simpa only [hSame] using ih
        · exact TaggedAmalgam.DependencyAncestor.step ih
            ⟨hLt, u, v, rfl, rfl, hEdge⟩

/-- Reachability is unchanged when the one-step relations coincide. -/
private theorem vertexReach_congr
    {d e : V → V → Prop}
    (hstep : ∀ u v, d u v ↔ e u v)
    {x y : V} (h : VertexReach d x y) :
    VertexReach e x y := by
  induction h with
  | root => exact VertexReach.root
  | @next u v hReach hEdge ih =>
      exact VertexReach.next ih ((hstep u v).mp hEdge)

/-- Two component indices induce identical one-step relations when
they agree on component equivalence and orientation of each edge. -/
theorem backOrSame_congr {n m : ℕ}
    (G : GraphOn V) (κ : V → Fin n)
    (λ : V → Fin m)
    (hComponents : ∀ u v, κ u = κ v ↔ λ u = λ v)
    (hOrientation : ∀ u v, G.adj u v →
      ((κ v).val < (κ u).val ↔ (λ v).val < (λ u).val))
    (u v : V) :
    BackOrSame G κ u v ↔ BackOrSame G λ u v := by
  constructor
  · intro h
    rcases h with hSame | ⟨hEdge, hEarlier⟩
    · exact Or.inl ((hComponents u v).mp hSame)
    · exact Or.inr ⟨hEdge,
        (hOrientation u v hEdge).mp hEarlier⟩
  · intro h
    rcases h with hSame | ⟨hEdge, hEarlier⟩
    · exact Or.inl ((hComponents u v).mpr hSame)
    · exact Or.inr ⟨hEdge,
        (hOrientation u v hEdge).mpr hEarlier⟩

/-- The complete set-valued C0 closure does not depend on the
chronological order of incomparable components. In particular,
renumbering a shared closed base to align two finite presentations
preserves every named unary function value, not just old neighbours. -/
theorem canonicalValue_eq_of_same_components_and_edge_orientation
    {n m : ℕ} (G : GraphOn V)
    (κ : V → Fin n) (λ : V → Fin m)
    (hComponents : ∀ u v, κ u = κ v ↔ λ u = λ v)
    (hOrientation : ∀ u v, G.adj u v →
      ((κ v).val < (κ u).val ↔ (λ v).val < (λ u).val))
    (x : V) :
    canonicalValue G κ x = canonicalValue G λ x := by
  classical
  apply Finset.ext
  intro y
  rw [mem_canonicalValue_iff_vertexReach,
    mem_canonicalValue_iff_vertexReach]
  constructor
  · exact vertexReach_congr
      (backOrSame_congr G κ λ hComponents hOrientation)
  · exact vertexReach_congr
      (fun u v =>
        (backOrSame_congr G κ λ hComponents hOrientation u v).symm)

end FiniteC0
end BigHrushovski
