import BigHrushovski.C0CanonicalOrderInvariance

/-!
# Canonical unary-value transport under a closed induced embedding

This is the concrete finite-graph interface needed in the last
two-sided C0 functional free-amalgamation assembly.

Given an induced graph injection f:U→W, suppose the component
partitions and the orientation of all graph edges on f[U] agree,
and suppose f[U] is closed under the COMPLETE canonical unary
function of W. Then every full vertex-valued unary function
commutes with f.

The proof uses vertex-level paths generated by same-component
steps and backwards graph edges. Every path beginning in the
closed factor stays inside it. The conclusion includes every
vertex of every reachable component.

The closed-image hypothesis is explicit: merely inducing the
graph and preserving component directions is insufficient, as
fresh earlier components may enlarge the unary closure.
-/

namespace BigHrushovski
namespace FiniteC0

variable {U W : Type*}
variable [Fintype U] [DecidableEq U]
variable [Fintype W] [DecidableEq W]
variable {n m : ℕ}

/-- An induced embedding preserving whole component equivalence
and the orientation of every edge preserves the exact one-step
same-component/backedge predecessor relation. -/
theorem backOrSame_embedding_iff
    (G : GraphOn U) (H : GraphOn W)
    (κ : U → Fin n) (κW : W → Fin m)
    (f : U → W)
    (hAdj : ∀ x y, G.adj x y ↔ H.adj (f x) (f y))
    (hComp : ∀ x y, κ x = κ y ↔ κW (f x) = κW (f y))
    (hOrient : ∀ x y, G.adj x y →
      ((κ y).val < (κ x).val ↔
       (κW (f y)).val < (κW (f x)).val))
    (x y : U) :
    BackOrSame G κ x y ↔ BackOrSame H κW (f x) (f y) := by
  constructor
  · intro h
    rcases h with heq | ⟨hEdge, hLt⟩
    · exact Or.inl ((hComp x y).mp heq)
    · exact Or.inr ⟨(hAdj x y).mp hEdge,
        (hOrient x y hEdge).mp hLt⟩
  · intro h
    rcases h with heq | ⟨hEdge, hLt⟩
    · exact Or.inl ((hComp x y).mpr heq)
    · have hEdge' : G.adj x y := (hAdj x y).mpr hEdge
      exact Or.inr ⟨hEdge',
        (hOrient x y hEdge').mpr hLt⟩

private theorem vertexReach_embedding
    (G : GraphOn U) (H : GraphOn W)
    (κ : U → Fin n) (κW : W → Fin m)
    (f : U → W)
    (hStep : ∀ x y, BackOrSame G κ x y ↔
      BackOrSame H κW (f x) (f y))
    {x y : U}
    (h : VertexReach (BackOrSame G κ) x y) :
    VertexReach (BackOrSame H κW) (f x) (f y) := by
  induction h with
  | root => exact VertexReach.root
  | @next a b ha hab ih =>
      exact VertexReach.next ih ((hStep a b).mp hab)

private theorem vertexReach_pullback_of_closed
    (G : GraphOn U) (H : GraphOn W)
    (κ : U → Fin n) (κW : W → Fin m)
    (f : U → W)
    (hStep : ∀ x y, BackOrSame G κ x y ↔
      BackOrSame H κW (f x) (f y))
    (hClosed : H.IsClosedUnderValues
      (canonicalValue H κW) ((Finset.univ : Finset U).image f))
    (root : U) {v : W}
    (h : VertexReach (BackOrSame H κW) (f root) v) :
    ∃ y : U, f y = v ∧
      VertexReach (BackOrSame G κ) root y := by
  induction h with
  | root => exact ⟨root, rfl, VertexReach.root⟩
  | @next x y hx hxy ih =>
      obtain ⟨u, hu, hReach⟩ := ih
      have hyClosed : y ∈ canonicalValue H κW (f root) :=
        (mem_canonicalValue_iff_vertexReach H κW (f root) y).mpr
          (VertexReach.next hx hxy)
      have hroot : f root ∈
          (Finset.univ : Finset U).image f :=
        Finset.mem_image.mpr ⟨root, Finset.mem_univ _, rfl⟩
      have hyImage : y ∈
          (Finset.univ : Finset U).image f :=
        hClosed (f root) hroot hyClosed
      obtain ⟨u', _, hu'⟩ := Finset.mem_image.mp hyImage
      have hstep' : BackOrSame G κ u u' := by
        apply (hStep u u').mpr
        simpa only [hu, hu'] using hxy
      exact ⟨u', hu', VertexReach.next hReach hstep'⟩

/-- Main transport theorem: a closed induced component-respecting
graph embedding preserves the COMPLETE named unary function. -/
theorem canonicalValue_transport_of_closed_embedding
    (G : GraphOn U) (H : GraphOn W)
    (κ : U → Fin n) (κW : W → Fin m)
    (f : U → W)
    (hAdj : ∀ x y, G.adj x y ↔ H.adj (f x) (f y))
    (hComp : ∀ x y, κ x = κ y ↔ κW (f x) = κW (f y))
    (hOrient : ∀ x y, G.adj x y →
      ((κ y).val < (κ x).val ↔
       (κW (f y)).val < (κW (f x)).val))
    (hClosed : H.IsClosedUnderValues
      (canonicalValue H κW) ((Finset.univ : Finset U).image f))
    (x : U) :
    canonicalValue H κW (f x) =
      (canonicalValue G κ x).image f := by
  classical
  have hStep :
      ∀ u v, BackOrSame G κ u v ↔
        BackOrSame H κW (f u) (f v) :=
    backOrSame_embedding_iff G H κ κW f hAdj hComp hOrient
  apply Finset.ext
  intro z
  constructor
  · intro hz
    obtain ⟨u, hu, huReach⟩ :=
      vertexReach_pullback_of_closed G H κ κW f hStep hClosed x
        ((mem_canonicalValue_iff_vertexReach H κW (f x) z).mp hz)
    exact Finset.mem_image.mpr
      ⟨u, (mem_canonicalValue_iff_vertexReach G κ x u).mpr
        huReach, hu⟩
  · intro hz
    obtain ⟨u, hu, huz⟩ := Finset.mem_image.mp hz
    have hReach :
        VertexReach (BackOrSame G κ) x u :=
      (mem_canonicalValue_iff_vertexReach G κ x u).mp hu
    have hTarget := vertexReach_embedding
      G H κ κW f hStep hReach
    rw [← huz]
    exact (mem_canonicalValue_iff_vertexReach
      H κW (f x) (f u)).mpr hTarget

end FiniteC0
end BigHrushovski
