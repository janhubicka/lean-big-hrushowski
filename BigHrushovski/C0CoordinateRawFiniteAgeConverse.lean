import BigHrushovski.C0FiniteTwoFactorAmalgamTransport
import BigHrushovski.C0CoordinateNormalizedUnionGraph
import BigHrushovski.C0CoordinateNormalizedFactorValues
import BigHrushovski.C0CoordinateRawClosedOverlapStrong
import BigHrushovski.C0CoordinateRawHostFiniteClosure

/-!
# Finite functional age of the preliminary raw C₀ coordinate host

Each one-generated raw C-value has an actual finite canonical C₀
stage/value witness. Two finitely presented C-closed raw-host sets
have a complete C-closed common base with identical named values;
their exclusive parts have no crossing edges. The finite two-sided
functional amalgamation theorem therefore gives a canonical witness
on their union, once its tagged carrier is identified with the
literal union.

We do that here, using the exact normalized graph equivalence and
the complete C-value transport on both factor images already proved
in the preceding modules. Then we induct on a finite *generating
set* F to obtain a witness on cl(F), rather than deleting points
from a closed set, which need not preserve closedness.

Every finite C-closed raw-host substructure is generated by all
of its vertices, so it belongs to the broad finite functional C₀
age with empty-or-minimal-strong component stages. This does NOT
yet identify that broad presentation with the stricter nonempty
raw-code source format, select a coherent ordered local catalogue,
or construct W, the return map, or any Ramsey theorem.
-/

namespace BigHrushovski
namespace FiniteUnaryCoordinates

variable [DecidableEq RawC0CoordinateVertex]

/-- A literal union of two already presented finite C-closed subsets
of the raw coordinate host has a canonical finite stage/value
presentation. This is the actual finite free-amalgamation induction
step, preserving the ENTIRE unary C-operation and all graph nonedges. -/
theorem RawC0CoordinateVertex.hasStageValuePresentation_union
    (s t : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s)
    (ht : RawC0CoordinateVertex.IsClosed t)
    (hS : RawC0CoordinateVertex.HasStageValuePresentation s)
    (hT : RawC0CoordinateVertex.HasStageValuePresentation t) :
    RawC0CoordinateVertex.HasStageValuePresentation (s ∪ t) := by
  classical
  let P : Type := {q : RawC0CoordinateVertex // q ∈ s ∩ t}
  let i : P → s := RawC0CoordinateVertex.overlapLeft s t
  let j : P → t := RawC0CoordinateVertex.overlapRight s t
  let hi : Function.Injective i :=
    RawC0CoordinateVertex.overlapLeft_injective s t
  let hj : Function.Injective j :=
    RawC0CoordinateVertex.overlapRight_injective s t
  let G : GraphOn s :=
    rawC0HostGraph.pullback
      (Subtype.val : s → RawC0CoordinateVertex)
  let H : GraphOn t :=
    rawC0HostGraph.pullback
      (Subtype.val : t → RawC0CoordinateVertex)
  let GY : GraphOn (s ∪ t) :=
    rawC0HostGraph.pullback
      (Subtype.val : (s ∪ t) → RawC0CoordinateVertex)
  let e := RawC0CoordinateVertex.normalizedAmalgamUnionEquiv s t
  let F : P → Finset P :=
    fun p => RawC0CoordinateVertex.valueOn (s ∩ t) p
  have hAgree : ∀ p q : P,
      G.adj (i p) (i q) ↔ H.adj (j p) (j q) := by
    intro p q
    exact RawC0CoordinateVertex.overlap_graph_agree s t p q
  have hBaseA : ∀ p : P,
      RawC0CoordinateVertex.valueOn s (i p) =
        (F p).image i := by
    intro p
    exact (RawC0CoordinateVertex.overlap_value_left s t hs ht p).symm
  have hBaseB : ∀ p : P,
      RawC0CoordinateVertex.valueOn t (j p) =
        (F p).image j := by
    intro p
    exact (RawC0CoordinateVertex.overlap_value_right s t hs ht p).symm
  have hGraph : ∀ x y : TaggedAmalgam.Carrier P
      (FiniteSpan.Tail i) (FiniteSpan.Tail j),
      (TaggedAmalgam.freeGraph
        (FiniteSpan.normalGraph G i hi)
        (FiniteSpan.normalGraph H j hj)).adj x y ↔
        GY.adj (e x) (e y) := by
    intro x y
    exact RawC0CoordinateVertex.normalizedAmalgam_union_graph
      s t hs ht x y
  have hYLeft : ∀ a : s,
      (RawC0CoordinateVertex.valueOn s a).image
        (e ∘ FiniteSpan.leftAmalgamEmbedding i hi j) =
      RawC0CoordinateVertex.valueOn (s ∪ t)
        (e (FiniteSpan.leftAmalgamEmbedding i hi j a)) := by
    intro a
    exact RawC0CoordinateVertex.normalizedUnion_left_fullC s t hs a
  have hYRight : ∀ b : t,
      (RawC0CoordinateVertex.valueOn t b).image
        (e ∘ FiniteSpan.rightAmalgamEmbedding i j hj) =
      RawC0CoordinateVertex.valueOn (s ∪ t)
        (e (FiniteSpan.rightAmalgamEmbedding i j hj b)) := by
    intro b
    exact RawC0CoordinateVertex.normalizedUnion_right_fullC s t ht b
  exact hasCanonicalC0StageValues_of_twoSidedAmalgamEquiv
    G H (RawC0CoordinateVertex.valueOn s)
    (RawC0CoordinateVertex.valueOn t)
    i j hi hj hAgree F hBaseA hBaseB hS hT
    GY (RawC0CoordinateVertex.valueOn (s ∪ t))
    e hGraph hYLeft hYRight

/-- The empty induced raw-host structure has the vacuous canonical
finite presentation. This handles empty-generated closures without
assuming the finite carrier is inhabited or introducing empty
component steps as nonempty ones. -/
theorem RawC0CoordinateVertex.empty_hasStageValuePresentation :
    RawC0CoordinateVertex.HasStageValuePresentation
      (∅ : Finset RawC0CoordinateVertex) := by
  classical
  refine ⟨0, ?_, ?_, ?_⟩
  · intro q
    exact False.elim (by simpa using q.property)
  · intro k hk
    omega
  · intro q
    exact False.elim (by simpa using q.property)

/-- Adjoining one generator adds exactly its full one-generated
closure to the complete finite closure of the previous generators.
This is the induction identity for the raw set-valued unary C. -/
theorem RawC0CoordinateVertex.closeFinite_insert
    (q : RawC0CoordinateVertex)
    (F : Finset RawC0CoordinateVertex) :
    RawC0CoordinateVertex.closeFinite (insert q F) =
      q.closedValue ∪ RawC0CoordinateVertex.closeFinite F := by
  classical
  ext r
  constructor
  · intro hr
    obtain ⟨w,hw,hwr⟩ :=
      (RawC0CoordinateVertex.mem_closeFinite_iff (insert q F) r).mp hr
    rcases Finset.mem_insert.mp hw with hq | hwF
    · subst w
      exact Finset.mem_union.mpr (Or.inl hwr)
    · exact Finset.mem_union.mpr
        (Or.inr
          ((RawC0CoordinateVertex.mem_closeFinite_iff F r).mpr
            ⟨w,hwF,hwr⟩))
  · intro hr
    rcases Finset.mem_union.mp hr with hqr | hFr
    · exact (RawC0CoordinateVertex.mem_closeFinite_iff
        (insert q F) r).mpr
          ⟨q,Finset.mem_insert_self q F,hqr⟩
    · obtain ⟨w,hwF,hwr⟩ :=
        (RawC0CoordinateVertex.mem_closeFinite_iff F r).mp hFr
      exact (RawC0CoordinateVertex.mem_closeFinite_iff
        (insert q F) r).mpr
          ⟨w,Finset.mem_insert_of_mem hwF,hwr⟩

/-- The complete unary closure of every FINITE generator set has a
canonical finite C₀ component presentation, allowing empty stages.
The induction adds entire C-values: deleting a point directly from
a closed set would not in general preserve C-closedness. -/
theorem RawC0CoordinateVertex.closeFinite_hasStageValuePresentation
    (F : Finset RawC0CoordinateVertex) :
    RawC0CoordinateVertex.HasStageValuePresentation
      (RawC0CoordinateVertex.closeFinite F) := by
  classical
  induction F using Finset.induction_on with
  | empty =>
      have hEmpty :
          RawC0CoordinateVertex.closeFinite
            (∅ : Finset RawC0CoordinateVertex) = ∅ := by
        ext q
        simp [RawC0CoordinateVertex.mem_closeFinite_iff]
      simpa only [hEmpty] using
        RawC0CoordinateVertex.empty_hasStageValuePresentation
  | @insert q F hnot ih =>
      have hUnion :=
        RawC0CoordinateVertex.closeFinite_insert q F
      rw [hUnion]
      exact RawC0CoordinateVertex.hasStageValuePresentation_union
        q.closedValue (RawC0CoordinateVertex.closeFinite F)
        (q.closedValue_isClosed)
        (RawC0CoordinateVertex.closeFinite_isClosed F)
        (q.closedValue_hasStageValuePresentation) ih

/-- CONVERSE FINITE-AGE THEOREM FOR THE PRELIMINARY RAW HOST.
Every finite subset closed under its complete set-valued unary
operation has an actual finite canonical C₀ presentation of the
induced graph and the ENTIRE named C-operation, with all stages empty
or minimal strong. This is not the chosen ORDERED age of the
manuscript and does not construct W or the countable return map. -/
theorem RawC0CoordinateVertex.closed_hasStageValuePresentation
    (s : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s) :
    RawC0CoordinateVertex.HasStageValuePresentation s := by
  have hEq : RawC0CoordinateVertex.closeFinite s = s :=
    Finset.Subset.antisymm
      (RawC0CoordinateVertex.closeFinite_le_closed
        s s Finset.Subset.rfl hs)
      (RawC0CoordinateVertex.subset_closeFinite s)
  rw [← hEq]
  exact RawC0CoordinateVertex.closeFinite_hasStageValuePresentation s

/-- Every finite complete-C-closed raw-host substructure is
2-sparse, as a consequence of its actual canonical finite C₀
stage/value witness. This does not assume sparsity independently. -/
theorem RawC0CoordinateVertex.closed_twoSparse
    (s : Finset RawC0CoordinateVertex)
    (hs : RawC0CoordinateVertex.IsClosed s) :
    (rawC0HostGraph.pullback
      (Subtype.val : s → RawC0CoordinateVertex)).IsTwoSparse
        (Finset.univ : Finset s) := by
  exact hasCanonicalC0StageValues_twoSparse
    (rawC0HostGraph.pullback
      (Subtype.val : s → RawC0CoordinateVertex))
    (RawC0CoordinateVertex.valueOn s)
    (RawC0CoordinateVertex.closed_hasStageValuePresentation s hs)

/-- The complete unary closure of any finite family of raw codes
has a 2-sparse induced graph. The proof is by the finite-stage
age theorem, not by an assumed global sparsity of the raw host. -/
theorem RawC0CoordinateVertex.closeFinite_twoSparse
    (F : Finset RawC0CoordinateVertex) :
    (rawC0HostGraph.pullback
      (Subtype.val :
        RawC0CoordinateVertex.closeFinite F → RawC0CoordinateVertex)).IsTwoSparse
        (Finset.univ : Finset (RawC0CoordinateVertex.closeFinite F)) := by
  exact RawC0CoordinateVertex.closed_twoSparse
    (RawC0CoordinateVertex.closeFinite F)
    (RawC0CoordinateVertex.closeFinite_isClosed F)

end FiniteUnaryCoordinates
end BigHrushovski
