import BigHrushovski.C0CoordinateFiniteAge

/-!
# Root-generated finite coordinate subcodes

A pointed code for the coordinate host W must be generated by its
distinguished point. Unary-closedness of its support, even together
with membership of the point, is not sufficient: a union of two
independent one-generated components is a counterexample.

This module records the missing exact support equality and proves
it for restrictions to the whole unary value of the distinguished
point. It deliberately does not declare every finite incidence code
a permitted ordered C₀ structure.
-/

namespace BigHrushovski
namespace FiniteUnaryCoordinates

/-- The finite pointed support is EXACTLY the set named by the
complete unary value of the distinguished point. -/
def LiteralPointedCode.IsGeneratedByPoint
    (q : LiteralPointedCode) : Prop :=
  ∀ y : ℕ, y ∈ q.support ↔ (q.point, y) ∈ q.closurePairs

variable {U : Type*} [Fintype U] [LinearOrder U] [DecidableEq U]

/-- Restricting a complete finite code to C(v), and re-pointing it
at v, gives a genuinely one-generated code. Reflexivity is needed
to ensure that the new distinguished point belongs to its support. -/
theorem literalPointedCode_restrict_generated
    (G : GraphOn U) (C : U → Finset U)
    (e : U ↪o ℕ) (v : U) (hv : v ∈ C v) :
    let q := literalPointedCode G C e v
    let s := (C v).image e
    (q.restrictTo s (coordinateImage_subset_labelSupport e (C v))
      (e v) ((mem_coordinateImage_iff e (C v) v).mpr hv)).IsGeneratedByPoint := by
  classical
  let q := literalPointedCode G C e v
  let s := (C v).image e
  have hs : s ⊆ q.support :=
    coordinateImage_subset_labelSupport e (C v)
  have hp : e v ∈ s :=
    (mem_coordinateImage_iff e (C v) v).mpr hv
  change (q.restrictTo s hs (e v) hp).IsGeneratedByPoint
  intro y
  change y ∈ s ↔
    (e v, y) ∈ (q.restrictTo s hs (e v) hp).closurePairs
  constructor
  · intro hy
    obtain ⟨w, hw, heq⟩ := Finset.mem_image.mp hy
    apply (q.mem_restrictTo_closure_iff s hs (e v) hp (e v) y).mpr
    refine ⟨?_, hp, hy⟩
    rw [← heq]
    exact (mem_coordinateClosurePairs_iff C e v w).mpr hw
  · intro h
    exact ((q.mem_restrictTo_closure_iff s hs
      (e v) hp (e v) y).mp h).2.2

/-- Generated supports are also closed under complete unary values
when the underlying finite unary closure is transitive. -/
theorem literalPointedCode_restrict_generated_closed
    (G : GraphOn U) (C : U → Finset U)
    (e : U ↪o ℕ) (v : U)
    (hv : v ∈ C v)
    (hNested : ∀ a b : U, b ∈ C a → C b ⊆ C a) :
    let q := literalPointedCode G C e v
    let s := (C v).image e
    let r := q.restrictTo s
      (coordinateImage_subset_labelSupport e (C v))
      (e v) ((mem_coordinateImage_iff e (C v) v).mpr hv)
    r.IsGeneratedByPoint ∧ r.ClosedSubset s := by
  classical
  constructor
  · exact literalPointedCode_restrict_generated G C e v hv
  · apply LiteralPointedCode.closedSubset_of_restrictTo
      (q := literalPointedCode G C e v)
      (s := (C v).image e)
      (t := (C v).image e)
      (coordinateImage_subset_labelSupport e (C v))
    · exact literalPointedCode_generatedClosed G C e v v hNested
    · exact Finset.Subset.rfl
    · exact e v
    · exact (mem_coordinateImage_iff e (C v) v).mpr hv

end FiniteUnaryCoordinates

namespace FiniteC0

open FiniteUnaryCoordinates

variable {V : Type*} [Fintype V] [LinearOrder V] [DecidableEq V]
variable {n : ℕ}

/-- Every one-generated canonical finite C₀ closure yields a literal
pointed code generated by its own distinguished coordinate and
closed under the complete canonical unary operation. This is a
necessary finite-age certificate, not the global host construction. -/
theorem canonicalValue_generated_pointedCode
    (G : GraphOn V) (κ : V → Fin n)
    (e : V ↪o ℕ) (a : V) :
    let C := canonicalValue G κ
    let q := literalPointedCode G C e a
    let s := (C a).image e
    let r := q.restrictTo s
      (coordinateImage_subset_labelSupport e (C a))
      (e a) ((mem_coordinateImage_iff e (C a) a).mpr
        (canonicalValue_mem_self G κ a))
    r.IsGeneratedByPoint ∧ r.ClosedSubset s := by
  apply literalPointedCode_restrict_generated_closed
  · exact canonicalValue_mem_self G κ a
  · intro u v huv w hvw
    exact canonicalValue_mem_trans G κ huv hvw

end FiniteC0
end BigHrushovski
