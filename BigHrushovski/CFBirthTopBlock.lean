import BigHrushovski.CFBirthBValues

/-!
# The top birth block of a generated C_F closure

The b-closure of a fresh vertex of request r at level n consists
of its *whole* literal fresh block and the finite b-closure of
r's old named support. All members of that support closure were
born before n. Consequently the unique block of the latest
birth level in C(v) is exactly the fresh block B(v).

This explicit decomposition makes the block recognizable from
the generated closure and birth-level preorder. It is the
graph-theoretic piece needed to recover complete b-values
from the (R,H) presentation. No root-set equivalence relation
or quotient of the countable vertex carrier is introduced.
-/

namespace BigHrushovski
namespace CFCoherentTower

-- Dependent finite carriers require additional elaboration fuel here.
set_option maxHeartbeats 1200000

/-- Leastness of the finite generated b-closure against any
finite complete-block closed container. -/
theorem birthGeneratedClosure_le_of_closed
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (s t : Finset (Vertex F K))
    (hst : s ⊆ t) (ht : IsBirthBlockClosed F K t) :
    birthGeneratedClosure F K s ⊆ t :=
  (Classical.choose_spec
    (exists_least_finite_birthBlockClosure F K s)).2.2 t hst ht

/-- The old named support of a request lies in the preceding
birth stage, not merely in some finite later stage. -/
theorem birthSupport_subset_stageImage
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n) :
    birthSupport F K n r ⊆ stageImage F K n := by
  intro v hv
  exact (mem_stageImage_iff_birth_lt F K n v).mpr
    (birthSupport_birth_lt F K n r hv)

/-- The b-closure generated by a support stays entirely in the
preceding stage, because stage images are already b-closed. -/
theorem birthGeneratedSupport_subset_stageImage
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n) :
    birthGeneratedClosure F K (birthSupport F K n r) ⊆
      stageImage F K n :=
  birthGeneratedClosure_le_of_closed F K
    (birthSupport F K n r) (stageImage F K n)
    (birthSupport_subset_stageImage F K n r)
    (stageImage_birthBlockClosed F K n)

/-- The first component of each actual tagged fresh block vertex
is its common birth level n. -/
theorem birthBlock_birth_eq
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n)
    {v : Vertex F K} (hv : v ∈ birthBlock F K n r) :
    v.1 = n := by
  classical
  obtain ⟨w, hw, hwv⟩ := Finset.mem_image.mp hv
  obtain ⟨i, _, hi⟩ := Finset.mem_image.mp hw
  have hV : v = (⟨n, ⟨r, i⟩⟩ : Vertex F K) := by
    calc
      v = toVertex F K (n + 1) w := hwv.symm
      _ = toVertex F K (n + 1) (Sum.inr ⟨r, i⟩) := by rw [hi]
      _ = (⟨n, ⟨r, i⟩⟩ : Vertex F K) := rfl
  rw [hV]

/-- Every vertex of a tagged request block has the same *whole*
auxiliary b-value, including its exact named old support. -/
theorem birthBValue_eq_of_mem_block
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n)
    {v : Vertex F K} (hv : v ∈ birthBlock F K n r) :
    birthBValue F K v =
      birthSupport F K n r ∪ birthBlock F K n r := by
  classical
  obtain ⟨w, hw, hwv⟩ := Finset.mem_image.mp hv
  obtain ⟨i, _, hi⟩ := Finset.mem_image.mp hw
  have hV : v = (⟨n, ⟨r, i⟩⟩ : Vertex F K) := by
    calc
      v = toVertex F K (n + 1) w := hwv.symm
      _ = toVertex F K (n + 1) (Sum.inr ⟨r, i⟩) := by rw [hi]
      _ = (⟨n, ⟨r, i⟩⟩ : Vertex F K) := rfl
  rw [hV]
  rfl

/-- The support closure together with the fresh block is itself
b-closed: old blocks remain closed, and every vertex of the
fresh block demands only its own block and the old support. -/
theorem birthSupportClosure_union_block_bClosed
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n) :
    IsBirthBlockClosed F K
      (birthGeneratedClosure F K (birthSupport F K n r) ∪
        birthBlock F K n r) := by
  let c := birthGeneratedClosure F K (birthSupport F K n r)
  let B := birthBlock F K n r
  let P := birthSupport F K n r
  have hc : IsBirthBlockClosed F K c :=
    birthGeneratedClosure_closed F K P
  have hPc : P ⊆ c :=
    birthGeneratedClosure_contains F K P
  apply (birthBlockClosed_iff_bValue_subset F K (c ∪ B)).mpr
  intro v hv
  rcases Finset.mem_union.mp hv with hvc | hvB
  · exact (birthBValue_subset_of_closed F K c hc hvc).trans
      Finset.subset_union_left
  · have hvValue : birthBValue F K v = P ∪ B :=
      birthBValue_eq_of_mem_block F K n r hvB
    rw [hvValue]
    exact Finset.union_subset
      (hPc.trans Finset.subset_union_left)
      Finset.subset_union_right

/-- The generated closure of a vertex is precisely its entire
birth block together with the closure of its old named support.
This identity is independent of the fresh ordinal i. -/
theorem birthGeneratedClosure_fresh_decompose
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n)
    (i : Fin r.code.1.val) :
    birthGeneratedClosure F K
        ({(⟨n, ⟨r, i⟩⟩ : Vertex F K)} : Finset (Vertex F K)) =
      birthGeneratedClosure F K (birthSupport F K n r) ∪
        birthBlock F K n r := by
  let v : Vertex F K := ⟨n, ⟨r, i⟩⟩
  let C := birthGeneratedClosure F K ({v} : Finset (Vertex F K))
  let P := birthSupport F K n r
  let B := birthBlock F K n r
  let c := birthGeneratedClosure F K P
  have hCClosed : IsBirthBlockClosed F K C :=
    birthGeneratedClosure_closed F K ({v})
  have hvC : v ∈ C :=
    (birthGeneratedClosure_contains F K ({v}))
      (Finset.mem_singleton_self v)
  have hValue : P ∪ B ⊆ C :=
    birthBValue_subset_of_closed F K C hCClosed hvC
  have hPc : P ⊆ C := Finset.subset_union_left.trans hValue
  have hBc : B ⊆ C := Finset.subset_union_right.trans hValue
  have hcc : c ⊆ C :=
    birthGeneratedClosure_le_of_closed F K P C hPc hCClosed
  have hL : c ∪ B ⊆ C :=
    Finset.union_subset hcc hBc
  have hR : C ⊆ c ∪ B := by
    apply birthGeneratedClosure_le_of_closed F K
      ({v} : Finset (Vertex F K)) (c ∪ B)
    · intro w hw
      have hwv : w = v := by simpa using hw
      subst w
      exact Finset.mem_union.mpr
        (Or.inr (birthFresh_mem_block F K n r i))
    · exact birthSupportClosure_union_block_bClosed F K n r
  exact le_antisymm hR hL

/-- The top birth-level part of the finite b-closure of v is
exactly the whole fresh block containing v. Other components
are forced by earlier supports and thus have smaller birth. -/
theorem birthGeneratedClosure_topBlock_iff
    (F : ℕ → ℝ) (K : ℕ → ℕ)
    (n : ℕ) (r : BirthRequest F K n)
    (i : Fin r.code.1.val)
    (w : Vertex F K) :
    w ∈ birthGeneratedClosure F K
      ({(⟨n, ⟨r, i⟩⟩ : Vertex F K)} : Finset (Vertex F K)) ∧
        w.1 = n ↔
      w ∈ birthBlock F K n r := by
  rw [birthGeneratedClosure_fresh_decompose F K n r i]
  constructor
  · intro h
    rcases Finset.mem_union.mp h.1 with hwC | hwB
    · have hStage := birthGeneratedSupport_subset_stageImage F K n r hwC
      have hLt : w.1 < n :=
        (mem_stageImage_iff_birth_lt F K n w).mp hStage
      exact False.elim ((Nat.ne_of_lt hLt) h.2)
    · exact hwB
  · intro hw
    exact ⟨Finset.mem_union.mpr (Or.inr hw),
      birthBlock_birth_eq F K n r hw⟩

end CFCoherentTower
end BigHrushovski
