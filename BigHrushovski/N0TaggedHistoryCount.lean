import BigHrushovski.N0CanonicalStageChoices
import BigHrushovski.FiniteReachableHistoryCount
import Mathlib.Tactic

/-!
# Dependent finite histories of actual SCC-order choices

The actual internal order of a strongly connected component B
has type Fin (card B) ≃ B. These types depend on B; we cannot
pretend that all components have one common set of internal orders.

We record each choice by a tag consisting of its actual SCC B and
a bijective enumeration of B. A history is a list of these tags,
stored most recent first. Reading it in chronological order and
updating the canonical default assignment gives a complete family
of component enumerations, with future components still at default.

For a prescribed SCC ranking r, the next tagged choices are exactly
the already-defined concrete canonical next orders of the component
in position history.length. There are no choices after all components
have been processed.

Assuming the previously isolated uniform actual next-choice
cardinality at every complete context, the reachable-history theorem
proves the product of the local factors in ranking order. This module
does not yet claim a bijection between such histories and all
canonical global orders.
-/

namespace BigHrushovski
namespace FiniteOrientation

variable {V : Type*} [Fintype V] [DecidableEq V]
variable (O : FiniteOrientation V)

/-- A choice of an enumeration of *one actual SCC*, tagged by
its component. This is a dependent sum, retaining the real carrier
rather than replacing it by a common artificial order type. -/
abbrev TaggedComponentOrder : Type _ :=
  Σ B : O.ComponentObject,
    Fin (Fintype.card (↥B.val)) ≃ (↥B.val)

/-- Execute a reverse-chronological sequence of actual choices,
starting with arbitrary defaults at every SCC. -/
noncomputable def ordersFromReverseHistory
    (history : List O.TaggedComponentOrder) :
    O.ComponentLocalEnumerations :=
  history.reverse.foldl
    (fun orders choice => O.withComponentOrder orders choice.1 choice.2)
    O.defaultComponentOrders

/-- The complete assignment generated by an empty choice history
is the fixed default enumeration family. -/
theorem ordersFromReverseHistory_nil :
    O.ordersFromReverseHistory [] = O.defaultComponentOrders := by
  rfl

/-- The local stabilizer factor for the SCC in rank n. It is zero
once n lies outside the actual component ordinal. -/
noncomputable def rankLocalFactor
    (r : O.ComponentRanking) (n : ℕ) : ℕ :=
  if h : n < Fintype.card O.ComponentObject then
    O.componentLocalFactor (r.symm ⟨n, h⟩)
  else 0

/-- Concrete permitted next tagged choices. When the history
contains fewer than m components, the new component is exactly
the one having that rank. The choices themselves may depend
on the entire preceding labelled history. -/
noncomputable def canonicalTaggedNextChoices
    (r : O.ComponentRanking)
    (history : List O.TaggedComponentOrder) :
    Finset O.TaggedComponentOrder := by
  classical
  if h : history.length < Fintype.card O.ComponentObject then
    let B : O.ComponentObject := r.symm ⟨history.length, h⟩
    exact (O.canonicalNextComponentChoices r
      (O.ordersFromReverseHistory history) B).image
      (fun choice => (⟨B, choice⟩ : O.TaggedComponentOrder))
  else
    exact ∅

/-- Tagging the actual next choices does not change the number
of possible orders of B, because the SCC tag is fixed and
different internal orders give different tagged records. -/
theorem canonicalTaggedNextChoices_card
    (r : O.ComponentRanking)
    (history : List O.TaggedComponentOrder)
    (h : history.length < Fintype.card O.ComponentObject) :
    (O.canonicalTaggedNextChoices r history).card =
      (O.canonicalNextComponentChoices r
        (O.ordersFromReverseHistory history)
        (r.symm ⟨history.length, h⟩)).card := by
  classical
  simp only [canonicalTaggedNextChoices, dif_pos h]
  apply Finset.card_image_iff.mpr
  intro a ha b hb hab
  cases hab
  rfl

/-- The sole mathematical hypothesis required for chronological
counting is uniformity of each actual canonical next-component
fibre. It is not necessary that the *sets* of next choices coincide. -/
theorem canonicalTaggedNextChoices_card_of_uniform
    (r : O.ComponentRanking)
    (hUniform :
      ∀ (orders : O.ComponentLocalEnumerations)
        (B : O.ComponentObject),
        (O.canonicalNextComponentChoices r orders B).card =
          O.componentLocalFactor B)
    (history : List O.TaggedComponentOrder) :
    (O.canonicalTaggedNextChoices r history).card =
      O.rankLocalFactor r history.length := by
  classical
  by_cases h : history.length < Fintype.card O.ComponentObject
  · rw [O.canonicalTaggedNextChoices_card r history h]
    simpa only [rankLocalFactor, dif_pos h] using
      hUniform (O.ordersFromReverseHistory history)
        (r.symm ⟨history.length, h⟩)
  · simp only [canonicalTaggedNextChoices, rankLocalFactor, dif_neg h, Finset.card_empty]

/-- The number of reachable length-m histories of *actual tagged*
SCC-order choices is the product of the true local cardinalities
in the prescribed ranking order, assuming uniform actual
next-component fibres. The next theorem is combinatorial and
does not yet identify histories with globally canonical orders. -/
theorem reachableTaggedHistories_card_of_uniform
    (r : O.ComponentRanking)
    (hUniform :
      ∀ (orders : O.ComponentLocalEnumerations)
        (B : O.ComponentObject),
        (O.canonicalNextComponentChoices r orders B).card =
          O.componentLocalFactor B) :
    (BigHrushovski.FiniteChoiceHistory.reachableHistories
      (O.canonicalTaggedNextChoices r)
      (Fintype.card O.ComponentObject)).card =
      ∏ i ∈ Finset.range (Fintype.card O.ComponentObject),
        O.rankLocalFactor r i := by
  have hFibres :
      ∀ (n : ℕ) (history : List O.TaggedComponentOrder),
        history ∈
          BigHrushovski.FiniteChoiceHistory.reachableHistories
            (O.canonicalTaggedNextChoices r) n →
        (O.canonicalTaggedNextChoices r history).card =
          O.rankLocalFactor r n := by
    intro n history hReach
    have hLen : history.length = n :=
      BigHrushovski.FiniteChoiceHistory.length_of_mem_reachableHistories
        (O.canonicalTaggedNextChoices r) n history hReach
    rw [← hLen]
    exact O.canonicalTaggedNextChoices_card_of_uniform r
      hUniform history
  exact BigHrushovski.FiniteChoiceHistory.reachableHistories_card
    (O.canonicalTaggedNextChoices r)
    (O.rankLocalFactor r) hFibres
    (Fintype.card O.ComponentObject)

end FiniteOrientation
end BigHrushovski
