import BigHrushovski.C0CountableReductCriterion
import BigHrushovski.C0FiniteCanonicalValues

/-!
# Finite closures for a complete set-valued unary operation

For a complete one-generated closure operation C, every vertex lies
in its own C-value and membership y ∈ C(x) implies C(y) ⊆ C(x).
Then the closure of a finite set s is the finite union
∪_{x∈s} C(x), without a choice of a closure iteration or a
separately supplied finite cover.

These conditions follow from the actual canonical C₀ component
presentation by reflexivity and transitivity of backward component
reachability. They are distinct from strong graph closure.

The final recognition theorem removes the separate finite
unary-closed-cover premise of C0CountableReductCriterion; it still
requires locally correct canonical stages, 2-sparsity and the full
labelled strong graph extension property.
-/

namespace BigHrushovski

namespace TaggedAmalgam

/-- Reflexive-transitive component reachability is transitive.
This purely combinatorial lemma is independent of sparsity. -/
theorem dependencyAncestor_trans {V : Type*}
    {d : V → V → Prop} {x y z : V}
    (hxy : DependencyAncestor d x y)
    (hyz : DependencyAncestor d y z) :
    DependencyAncestor d x z := by
  induction hyz with
  | root => exact hxy
  | step hPath hEdge ih =>
      exact DependencyAncestor.step ih hEdge

end TaggedAmalgam

namespace FiniteC0

variable {V : Type*} [DecidableEq V]

/-- Exact two properties of a complete one-generated set-valued
closure operation: it contains the generator and contains the
entire closure of any of its own vertices. -/
def IsCompleteUnaryClosure (C : V → Finset V) : Prop :=
  (∀ x : V, x ∈ C x) ∧
  (∀ x y : V, y ∈ C x → C y ⊆ C x)

/-- Every finite canonical component presentation has a
reflexive complete unary value, including singleton components. -/
theorem canonicalValue_mem_self [Fintype V]
    {n : ℕ} (G : GraphOn V) (κ : V → Fin n) (x : V) :
    x ∈ canonicalValue G κ x := by
  exact (mem_canonicalValue_iff G κ x x).mpr
    TaggedAmalgam.DependencyAncestor.root

/-- Complete canonical unary values are transitive: whenever y is
in the full value of x, the *whole* full value of y is included
in the full value of x. No component generator is distinguished. -/
theorem canonicalValue_subset_of_mem [Fintype V]
    {n : ℕ} (G : GraphOn V) (κ : V → Fin n)
    {x y : V} (hxy : y ∈ canonicalValue G κ x) :
    canonicalValue G κ y ⊆ canonicalValue G κ x := by
  intro z hz
  apply (mem_canonicalValue_iff G κ x z).mpr
  exact TaggedAmalgam.dependencyAncestor_trans
    ((mem_canonicalValue_iff G κ x y).mp hxy)
    ((mem_canonicalValue_iff G κ y z).mp hz)

/-- The complete canonical unary operation on an arbitrary finite
component-indexed graph satisfies the two closure axioms. -/
theorem canonicalValue_isComplete [Fintype V]
    {n : ℕ} (G : GraphOn V) (κ : V → Fin n) :
    IsCompleteUnaryClosure (canonicalValue G κ) := by
  constructor
  · exact canonicalValue_mem_self G κ
  · intro x y hxy
    exact canonicalValue_subset_of_mem G κ hxy

/-- Finite closure generated by s: there is no transfinite
iteration, only the finite union of complete one-generated
values. -/
noncomputable def completeUnaryGenerated
    (C : V → Finset V) (s : Finset V) : Finset V :=
  s.biUnion C

theorem mem_completeUnaryGenerated
    (C : V → Finset V) (s : Finset V) (y : V) :
    y ∈ completeUnaryGenerated C s ↔
      ∃ x ∈ s, y ∈ C x := by
  classical
  simp [completeUnaryGenerated, Finset.mem_biUnion]

theorem completeUnaryGenerated_extensive
    (C : V → Finset V)
    (hSelf : ∀ x : V, x ∈ C x)
    (s : Finset V) :
    s ⊆ completeUnaryGenerated C s := by
  intro x hx
  exact (mem_completeUnaryGenerated C s x).mpr
    ⟨x, hx, hSelf x⟩

theorem completeUnaryGenerated_closed
    (N : GraphOn V) (C : V → Finset V)
    (hTrans : ∀ x y : V, y ∈ C x → C y ⊆ C x)
    (s : Finset V) :
    N.IsClosedUnderValues C (completeUnaryGenerated C s) := by
  intro x hx y hy
  obtain ⟨v, hv, hxv⟩ :=
    (mem_completeUnaryGenerated C s x).mp hx
  exact (mem_completeUnaryGenerated C s y).mpr
    ⟨v, hv, hTrans v x hxv hy⟩

/-- Every finite set is contained in a finite closed set under
a complete one-generated unary function. This is the exact
finite-cover hypothesis used by the countable reduct criterion. -/
theorem finiteUnaryClosedCovers
    (N : GraphOn V) (C : V → Finset V)
    (hComplete : IsCompleteUnaryClosure C) :
    ∀ s : Finset V, ∃ c : Finset V,
      s ⊆ c ∧ N.IsClosedUnderValues C c := by
  intro s
  exact ⟨completeUnaryGenerated C s,
    completeUnaryGenerated_extensive C hComplete.1 s,
    completeUnaryGenerated_closed N C hComplete.2 s⟩

/-- Recognition of M₀ from complete unary closure, finite
cofinal stages and the *labelled* strong extension property.
Unlike the preceding criterion, finite unary covers are
consequences, not a separately supplied premise. -/
theorem graphReduct_iso_generic_of_completeUnary
    (N : GraphOn ℕ)
    (C : ℕ → Finset ℕ)
    (stage : ℕ → Finset ℕ)
    (hComplete : IsCompleteUnaryClosure C)
    (hSparse : ∀ s : Finset ℕ, 0 ≤ N.predim s)
    (hCover : ∀ b : Finset ℕ, ∃ n : ℕ, b ⊆ stage n)
    (hLocal : ∀ (n : ℕ) (s : Finset ℕ),
      s ⊆ stage n →
      N.IsClosedUnderValues C s →
      N.toPredimension.IsStrong s (stage n))
    (hExt : FiniteCatalogue.HasStrongExtensionProperty N) :
    ∃ e : ℕ ≃ ℕ, ∀ x y : ℕ,
      FiniteCatalogue.genericTwoSparseGraph.adj x y ↔
        N.adj (e x) (e y) := by
  exact graphReduct_iso_generic_of_unaryPresentation
    N C stage hSparse hCover hLocal
    (finiteUnaryClosedCovers N C hComplete) hExt

end FiniteC0
end BigHrushovski
